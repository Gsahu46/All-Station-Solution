<?xml version="1.0" encoding="UTF-8"?>
<!-- The insurer's WSDL (simulated: Bimaly's partner insurer, "Suraksha General"). SOAP 1.1, document/literal. -->
<wsdl:definitions name="PolicyIssuance"
                  targetNamespace="http://insurer.example/policy/v1"
                  xmlns:tns="http://insurer.example/policy/v1"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <wsdl:types>
        <xs:schema targetNamespace="http://insurer.example/policy/v1" elementFormDefault="qualified">
            <xs:element name="IssuePolicyRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="customerName" type="xs:string"/>
                        <xs:element name="dateOfBirth" type="xs:date"/>
                        <xs:element name="productCode" type="xs:string"/>
                        <xs:element name="sumInsuredPaise" type="xs:long"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="IssuePolicyResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="policyNumber" type="xs:string"/>
                        <xs:element name="premiumPaise" type="xs:long"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="PolicyFault">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="code" type="xs:string"/>
                        <xs:element name="message" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="IssuePolicyInput">
        <wsdl:part name="parameters" element="tns:IssuePolicyRequest"/>
    </wsdl:message>
    <wsdl:message name="IssuePolicyOutput">
        <wsdl:part name="parameters" element="tns:IssuePolicyResponse"/>
    </wsdl:message>
    <wsdl:message name="PolicyFaultMessage">
        <wsdl:part name="fault" element="tns:PolicyFault"/>
    </wsdl:message>

    <wsdl:portType name="PolicyIssuancePort">
        <wsdl:operation name="IssuePolicy">
            <wsdl:input message="tns:IssuePolicyInput"/>
            <wsdl:output message="tns:IssuePolicyOutput"/>
            <wsdl:fault name="PolicyFault" message="tns:PolicyFaultMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="PolicyIssuanceSoapBinding" type="tns:PolicyIssuancePort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="IssuePolicy">
            <soap:operation soapAction="http://insurer.example/policy/v1/IssuePolicy"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="PolicyFault"><soap:fault name="PolicyFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="PolicyIssuanceService">
        <wsdl:port name="PolicyIssuancePort" binding="tns:PolicyIssuanceSoapBinding">
            <soap:address location="http://localhost:9088/policy"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
